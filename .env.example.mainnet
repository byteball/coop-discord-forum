# Mainnet configuration. Copy to .env and fill in the blanks:
#   cp .env.example.mainnet .env

# ---- Prisma / SQLite -------------------------------------------------------
# Prisma 7: path is relative to the working dir (project root).
DATABASE_URL="file:./prisma/data/contribution-log.db"

# ---- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications (required).
DISCORD_BOT_TOKEN=""
# Comma-separated forum channel ids to track. Empty = every GuildForum channel.
DISCORD_FORUM_CHANNEL_IDS=""

# ---- Obyte (mainnet) -------------------------------------------------------
# "false" connects to the mainnet hub (wss://obyte.org/bb).
OBYTE_TESTNET="false"
# Comma-separated attestors whose attestations map Discord userId -> Obyte
# address; the lookup tries them in order and uses the first match.
DISCORD_ATTESTOR_ADDRESSES="5KM36CFPBD2QJLVD65PHZG34WEM4RPY2"

# ---- COOP / attestation pairing --------------------------------------------
# COOP profile link posted in-thread: <COOP_BASE_URL>/user/<address>
COOP_BASE_URL="https://coop.obyte.org"
# Public base URL of this API (required) — used in Discord messages, e.g. the
# "link your account" prompt points to <PUBLIC_BASE_URL>/pair.
PUBLIC_BASE_URL="https://coop.obyte.org/contrib"
# obyte: pairing URI of the Discord attestation bot; the GET /pair page opens it.
ATTESTATION_BOT_PAIRING_URI="obyte:Ama48/uKO+/Tjv28zFKwElBO4SEQNuWAM1VPJkl4DTZO@obyte.org/bb#0000"

# ---- HTTP ------------------------------------------------------------------
PORT="2000"
# Comma-separated list of allowed browser origins; '*' allows any.
# Read-only public API without credentials, so '*' is a safe default.
CORS_ORIGIN="*"
# Per-IP rate limit (0 disables). Max requests per window.
RATE_LIMIT_MAX="0"
RATE_LIMIT_WINDOW_MS="60000"
# Set "true" only when running behind a trusted reverse proxy (rate-limit by
# X-Forwarded-For client IP). Leave false on direct exposure to avoid header spoofing.
TRUST_PROXY="false"
