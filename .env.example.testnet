# Testnet configuration. Copy to .env and fill in the blanks:
#   cp .env.example.testnet .env

# ---- Prisma / SQLite -------------------------------------------------------
# Prisma 7: path is relative to the working dir (project root).
DATABASE_URL="file:./prisma/data/contribution-log.db"

# ---- Discord ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications (required).
DISCORD_BOT_TOKEN=""
# Comma-separated forum channel ids to track. Empty = every GuildForum channel.
DISCORD_FORUM_CHANNEL_IDS=""

# ---- Obyte (testnet) -------------------------------------------------------
# "true" connects to the testnet hub (wss://obyte.org/bb-test).
OBYTE_TESTNET="true"
# Comma-separated attestors whose attestations map Discord userId -> Obyte
# address; the lookup tries them in order and uses the first match.
# Keep in sync with coop-ui testnet discordAttestors (src/shared/config/appConfig.ts).
DISCORD_ATTESTOR_ADDRESSES="WMFLGI2GLAB2MDF2KQAH37VNRRMK7A5N,5KM36CFPBD2QJLVD65PHZG34WEM4RPY2,UADF7ZDFREOUXMPRRGI2JHLKD2YQI5EV,AXUWOO2XGPQVRS4FGC2N6LCFLZ4LFRMJ,5K2U5I7R74XNZMG7LYGMHVXSQXIZDBKG"

# ---- COOP / attestation pairing --------------------------------------------
# COOP profile link posted in-thread: <COOP_BASE_URL>/user/<address>
# Local coop-ui dev server (pnpm dev in coop-ui runs on port 4000).
COOP_BASE_URL="http://localhost:4000"
# Public base URL of this API (required) — used in Discord messages, e.g. the
# "link your account" prompt points to <PUBLIC_BASE_URL>/pair.
PUBLIC_BASE_URL="http://localhost:3000"
# obyte-tn: pairing URI of the TESTNET Discord attestation bot; the GET /pair
# page opens it. REPLACE the placeholder with your bot's real pairing code —
# startup fails if the scheme does not match the network (obyte-tn: on testnet).
ATTESTATION_BOT_PAIRING_URI="obyte-tn:<attestation-bot-pubkey>@obyte.org/bb-test#0000"

# ---- HTTP ------------------------------------------------------------------
PORT="3000"
# Comma-separated list of allowed browser origins; '*' allows any.
# Read-only public API without credentials, so '*' is a safe default.
CORS_ORIGIN="*"
# Per-IP rate limit (0 disables). Max requests per window.
RATE_LIMIT_MAX="120"
RATE_LIMIT_WINDOW_MS="60000"
# Set "true" only when running behind a trusted reverse proxy (rate-limit by
# X-Forwarded-For client IP). Leave false on direct exposure to avoid header spoofing.
TRUST_PROXY="false"
